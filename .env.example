# Copy this file to .env before running Docker Compose.
# These values are for local development only. Use strong secrets in deployments.
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_VERSION=16
POSTGRES_PORT=5433
RESTORE_EXISTING_DATABASES=false
JWT_SECRET=change-this-to-a-random-secret-at-least-32-characters
INTERNAL_API_KEY=change-this-to-a-random-internal-api-key
PAYMENT_INTERNAL_API_KEY=change-this-to-a-random-payment-api-key
CHECKIN_INTERNAL_API_KEY=change-this-to-a-random-checkin-api-key
FRONTEND_PORT=8088
FRONTEND_ORIGIN=http://localhost:8088
