FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ARG VITE_API_BASE_URL=/api
ARG VITE_NOTIFICATION_API_URL=/api
ARG VITE_NOTIFICATION_HUB_URL=/hubs/notification
ARG VITE_CHECKIN_HTTP_URL=/api
ARG VITE_CHECKIN_HTTPS_URL=/api
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ENV VITE_NOTIFICATION_API_URL=${VITE_NOTIFICATION_API_URL}
ENV VITE_NOTIFICATION_HUB_URL=${VITE_NOTIFICATION_HUB_URL}
ENV VITE_CHECKIN_HTTP_URL=${VITE_CHECKIN_HTTP_URL}
ENV VITE_CHECKIN_HTTPS_URL=${VITE_CHECKIN_HTTPS_URL}
RUN npm run build

FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
